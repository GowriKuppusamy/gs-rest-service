# GitHub MCP token — used by .cursor/setup-mcp-env.ps1 to set Windows User env GITHUB_TOKEN.
# Copy to: .cursor/mcp.env
#
# Create PAT: https://github.com/settings/tokens
# Suggested scopes: repo, read:org, pull_requests
#
# Rules:
# - Token only — do NOT prefix with "Bearer "
# - No quotes around the value unless your token contains spaces (it should not)

GITHUB_TOKEN=your-github-personal-access-token
